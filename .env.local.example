# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase (Phase 1) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings -> API -> service_role (SECRET — server only, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Phase 4) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin panel (Phase 6) ---
# The admin has its own login at /admin/login — a SEPARATE credential, not a normal
# user account, and there is no admin signup. These are the fixed starting values;
# on first login they're saved to the DB, then the password is changed from
# /admin/account. Set a strong password here for the very first login.
ADMIN_EMAIL=you@fresh-leads.io
# Wrap the password in quotes if it contains a # (otherwise it's read as a comment).
ADMIN_PASSWORD="change-this-strong-first-password"
# Optional — overrides the session-cookie signing secret (defaults to the
# service-role key, which is already a strong secret, so this is optional).
ADMIN_SESSION_SECRET=

# --- Optional paid upgrades (leave blank to stay on the free heuristic tier) ---
# Real email deliverability. When set, lib/verify/email.ts calls ZeroBounce and
# can return a proven "deliverable"; when blank it falls back to syntax + MX.
# Get it at zerobounce.net → dashboard.
ZEROBOUNCE_API_KEY=
# Real phone validation. When both are set, lib/verify/phone.ts calls Twilio
# Lookup v2 to confirm the line is real and get carrier-grade line type; when
# blank it falls back to offline libphonenumber validation.
# Get these at twilio.com → Console (Account SID + Auth Token).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional lead-coverage upgrade (Phase 4). Google Maps/Places has more business
# coverage than the free OpenStreetMap data. SERVER-ONLY — never prefix NEXT_PUBLIC_.
# Get it at console.cloud.google.com (enable Places API + Geocoding API, restrict the key).
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Claude, for the "describe your ideal customer" box (lib/icp-parse.ts).
# OPTIONAL: without it the box still works, using deterministic keyword matching.
# Either name is accepted; the Anthropic SDK's own default is ANTHROPIC_API_KEY.
# NOTE: a valid key is not enough — the Anthropic account also needs a credit balance,
# or every call returns invalid_request_error and the parser falls back to keywords.
CLAUDE_API_KEY=
